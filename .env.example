# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env.
# Vite n'expose au navigateur que les variables préfixées VITE_, lues au build
# (relancer `npm run dev` après modification). Voir docs/LESSONS.md.

# RSVP (api/rsvp.ts, ADR-0003) : variables serveur, posées dans Vercel, jamais préfixées VITE_.
# Adresse de l'application web Apps Script attachée au Google Sheet (tools/sheets/Code.gs).
RSVP_SHEET_URL=
# Secret partagé entre la fonction et le script, une longue chaîne au hasard, la même des deux côtés.
RSVP_SECRET=

# BytePlus ModelArk (Seedance 2.5), uniquement pour tools/video/seedance.py, jamais lu par le site.
ARK_API_KEY=
